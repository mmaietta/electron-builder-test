{
  "name": "electron-quick-start-typescript",
  "version": "1.0.5",
  "description": "A minimal Electron application written with Typescript",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "pnpm build && electron ./out/main.js",
    "app:linux": "env CI=1 electron-builder --config electron-builder-config.ts --linux --x64 --arm64 && find dist/linux-unpacked -name **/*.node -exec file {} \\;",
    "app:pack": "electron-builder --config electron-builder-config.ts --publish never",
    "app:dist": "electron-builder --config electron-builder-config.ts --publish always",
    "postinstall": "patch-package && electron-builder install-app-deps"
  },
  "repository": "https://github.com/electron/electron-quick-start-typescript",
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo",
    "typescript"
  ],
  "author": {
    "name": "GitHub",
    "email": "test@test.com"
  },
  "license": "CC0-1.0",
  "devDependencies": {
    "@types/node": "^18.7.4",
    "@types/semver": "^7.5.7",
    "@typescript-eslint/eslint-plugin": "^4.29.2",
    "@typescript-eslint/parser": "^4.29.2",
    "basic-ftp": "^5.0.4",
    "electron": "23.3.10",
    "eslint": "^7.32.0",
    "lazy-val": "^1.0.5",
    "patch-package": "^8.0.0",
    "resedit": "1.7.0",
    "source-map-support": "^0.5.21",
    "electron-builder": "link:../electron-builder/packages/electron-builder",
    "app-builder-lib": "link:../electron-builder/packages/app-builder-lib",
    "builder-util": "link:../electron-builder/packages/builder-util",
    "builder-util-runtime": "link:../electron-builder/packages/builder-util-runtime",
    "dmg-builder": "link:../electron-builder/packages/dmg-builder",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "dotenv": "^16.4.4",
    "electron-log": "^4.4.1",
    "electron-updater": "^6.4"
  },
  "packageManager": "pnpm@10.10.0"
}
